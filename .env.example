# Local practice. No real Firebase account, billing, or private key is needed.
DEMO_MODE=emulator
FIREBASE_PROJECT_ID=demo-firebase-storage
FIREBASE_STORAGE_BUCKET=demo-firebase-storage.firebasestorage.app
# This flag controls the member-1 cloud Admin bucket check, not the local Web SDK.
STORAGE_ENABLED=false

# CLOUD: change mode and project/bucket above, then add all Web app fields below.
# DEMO_MODE=cloud
# FIREBASE_PROJECT_ID=student-file-hub-seminar-7a7f2
# FIREBASE_STORAGE_BUCKET=student-file-hub-seminar-7a7f2.firebasestorage.app
# STORAGE_ENABLED=true
# FIREBASE_WEB_API_KEY=YOUR_WEB_API_KEY_FROM_CONSOLE
# FIREBASE_AUTH_DOMAIN=student-file-hub-seminar-7a7f2.firebaseapp.com
# FIREBASE_APP_ID=YOUR_WEB_APP_ID_FROM_CONSOLE
# GOOGLE_APPLICATION_CREDENTIALS=secrets/serviceAccountKey.json
# Copy the EXACT bucket name without gs://. Keep the private key outside Git.
# Never enable FIREBASE_AUTH_EMULATOR_HOST / FIREBASE_STORAGE_EMULATOR_HOST in cloud.
