# Lấy chính xác từ Firebase Console > Project Settings > General
FIREBASE_PROJECT_ID=student-file-hub-seminar-7a7f2
# ĐỂ FALSE khi chưa nâng cấp Blaze
STORAGE_ENABLED=true
# CHỈ ĐIỀN SAU KHI TẠO BUCKET THẬT
FIREBASE_STORAGE_BUCKET=gs://student-file-hub-seminar-7a7f2.firebasestorage.app
# CHỈ SỬ DỤNG TRÊN BACKEND (không commit file key)
GOOGLE_APPLICATION_CREDENTIALS=secrets/serviceAccountKey.json
