# Choose ONE mode. For cloud setup, change DEMO_MODE to cloud below.
# Emulator mode does not require a Firebase project, Blaze or service account.
DEMO_MODE=emulator
FIREBASE_PROJECT_ID=demo-firebase-storage
STORAGE_ENABLED=false

# Phase 2: persistent sharing/trash metadata (default: project/.data).
# Keep this directory across server restarts; all workers share the same path.
# FILESPACE_DATA_DIR=.data

# CLOUD MODE ONLY (do not reuse credentials from another Firebase project):
# DEMO_MODE=cloud
# FIREBASE_PROJECT_ID=student-file-hub-seminar-7a7f2
# FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
# FIREBASE_AUTH_DOMAIN=student-file-hub-seminar-7a7f2.firebaseapp.com
# FIREBASE_STORAGE_BUCKET=student-file-hub-seminar-7a7f2.firebasestorage.app
# FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
# STORAGE_ENABLED=true
# GOOGLE_APPLICATION_CREDENTIALS=secrets/serviceAccountKey.json
